# Frontend environment variables (set these in deployment environment)
# These are read at build/runtime by CRA using process.env.REACT_APP_*
# Example:
# REACT_APP_SUPABASE_URL=https://xyzcompany.supabase.co
# REACT_APP_SUPABASE_KEY=public-anon-key-from-supabase-project-settings
REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_KEY=
